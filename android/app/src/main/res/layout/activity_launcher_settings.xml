<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/launcher_settings"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/appearance"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <Button
            android:id="@+id/wallpaper"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/wallpaper" />

        <Switch
            android:id="@+id/themedIcons"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/themed_icons" />

        <Switch
            android:id="@+id/notificationDots"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/notification_dots" />

        <Switch
            android:id="@+id/autoAddApps"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/auto_add_apps" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/grid"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <RadioGroup
            android:id="@+id/gridOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <ProgressBar
            android:id="@+id/gridProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/gridStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" />

        <Button
            android:id="@+id/selectHomeRole"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="@string/set_default_home" />

        <Button
            android:id="@+id/exportDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/export_diagnostics" />

        <Button
            android:id="@+id/resetLauncher"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/reset_state" />

        <TextView
            android:id="@+id/buildIdentity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
