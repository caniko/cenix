<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Public API 35 permission granted through the HOME role for hidden profile discovery. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".CenixApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cenix">

        <!-- Exported because Android requires HOME candidates to be launchable. -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Exported only for Android's validated launcher pin-shortcut confirmation contract. -->
        <activity
            android:name=".PinShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Cenix">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Exported only for Android's validated launcher pin-widget confirmation contract. -->
        <activity
            android:name=".PinWidgetActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Cenix">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WidgetPickerActivity"
            android:exported="false" />

        <activity
            android:name=".LauncherSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/launcher_settings"
            android:taskAffinity="${applicationId}.settings"
            android:theme="@style/Theme.Cenix.Settings" />

        <!-- Exported for Android's protected app-widget host restore broadcast. -->
        <receiver
            android:name=".WidgetRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_HOST_RESTORED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
